# Neon ላይ ያለው የPostgreSQL አድራሻ (Dashboard -> Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# በዚህ ትዕዛዝ ይፍጠሩ: npx @better-auth/cli secret  (ወይም ማንኛውም ረጅም የዘፈቀደ ጽሑፍ)
BETTER_AUTH_SECRET=""
# በLocal: http://localhost:3000  | በVercel: የድረ-ገጹ ሙሉ አድራሻ
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# የአድሚን ፈቃድ የሚያገኙ የGmail አድራሻዎች፣ በኮማ የተለዩ
ADMIN_EMAILS=""
