generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  SOLD
  ARCHIVED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  TRANSFERRED
  CONFIRMED
  RELEASED
  DISPUTED
  CANCELLED
}

model User {
  id             String   @id
  name           String
  email          String   @unique
  emailVerified  Boolean  @default(false)
  image          String?
  phone          String?
  suspended      Boolean  @default(false)
  verifiedSeller Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  listings           Listing[]
  offers             Offer[]
  purchases          Order[]        @relation("OrderBuyer")
  sales              Order[]        @relation("OrderSeller")
  buyerConversations Conversation[] @relation("ConversationBuyer")
  messages           Message[]
  reports            Report[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Listing {
  id               String        @id @default(cuid())
  sellerId         String
  seller           User          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  platform         String
  username         String
  followers        Int
  posts            Int?
  priceEtb         Int
  category         String
  country          String
  femaleShare      Int?
  engagement       Float?
  joinedYear       Int?
  originalEmail    Boolean       @default(false)
  special          Boolean       @default(false)
  monetized        Boolean       @default(false)
  strikeFree       Boolean       @default(false)
  noAdsense        Boolean       @default(false)
  description      String        @default("")
  verificationCode String
  status           ListingStatus @default(PENDING)
  rejectReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  offers        Offer[]
  orders        Order[]
  conversations Conversation[]
  reports       Report[]
  images        ListingImage[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([platform, username])
  @@map("listing")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position  Int
  width     Int
  height    Int
  data      Bytes
  thumb     Bytes
  createdAt DateTime @default(now())

  @@unique([listingId, position])
  @@map("listing_image")
}

model Offer {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  amountEtb Int
  note      String      @default("")
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order Order?

  @@index([listingId, status])
  @@index([buyerId])
  @@map("offer")
}

model Order {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offerId   String      @unique
  offer     Offer       @relation(fields: [offerId], references: [id], onDelete: Restrict)
  buyerId   String
  buyer     User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId  String
  seller    User        @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  amountEtb Int
  status    OrderStatus @default(AWAITING_PAYMENT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("order")
}

model Conversation {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

model Report {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([listingId, reporterId])
  @@index([resolved])
  @@map("report")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved])
  @@map("contact_message")
}

// ---- Telegram Business ክትትል
// ቦቱ ከድርጅቱ የቴሌግራም አካውንቶች ጋር በTelegram Business ይገናኛል፤ የሚመጡት መልዕክቶች እዚህ ይቀመጣሉ።

enum TelegramDirection {
  IN
  OUT
}

enum TelegramAlertType {
  PHONE_NUMBER
  TELEGRAM_CONTACT
  WHATSAPP
  BANK_ACCOUNT
  SUSPICIOUS_PHRASE
  DELETED_MESSAGE
  PAYMENT_TO_OTHER_ACCOUNT
  DUPLICATE_RECEIPT
  AI_SUSPICION
}

enum TelegramDealKind {
  SALE
  REGISTRATION
}

enum TelegramDealStatus {
  NEGOTIATING
  AGREED
  PAID
  DELIVERED
  CANCELLED
}

enum TelegramAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

/// አንድ የድርጅት የቴሌግራም አካውንት ከቦቱ ጋር ያለው ግንኙነት። id የቴሌግራሙ business_connection_id ነው።
model TelegramConnection {
  id            String   @id
  ownerId       BigInt
  ownerChatId   BigInt
  ownerName     String
  ownerUsername String?
  canReply      Boolean  @default(false)
  isEnabled     Boolean  @default(true)
  connectedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chats TelegramChat[]

  @@map("telegram_connection")
}

/// ከአንድ ደንበኛ ጋር ያለ ቻት። chatId የቴሌግራሙ የደንበኛ መለያ ነው።
model TelegramChat {
  id             String             @id @default(cuid())
  connectionId   String
  connection     TelegramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  chatId         BigInt
  name           String
  username       String?
  lastMessageAt  DateTime
  lastDirection  TelegramDirection
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  /// Claude የጻፈው የቻቱ አጭር ማጠቃለያ እና የተተነተነበት ጊዜ
  aiSummary      String?
  analyzedAt     DateTime?
  /// ደንበኛው ያጋራቸው ዝርዝሮች (ስልክ፣ ኢሜይል፣ አካውንቶች፣ ለሽያጭ ያመጣቸው)፤ ቅርጹ በlib/telegram/profile.ts ውስጥ ነው።
  profile        Json?
  /// በቁልፍ ቃል ወይም በAI የተገኙ ርዕሶች፤ ለምሳሌ "withdrawal" (ከቲክቶክ ገንዘብ ማውጣት፣ የPayPal/ዶላር ምንዛሬ)
  tags           String[]           @default([])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages TelegramMessage[]
  alerts   TelegramAlert[]
  deals    TelegramDeal[]

  @@unique([connectionId, chatId])
  @@index([lastMessageAt])
  @@index([lastDirection])
  @@map("telegram_chat")
}

model TelegramMessage {
  id           String            @id @default(cuid())
  chatId       String
  chat         TelegramChat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId    Int
  direction    TelegramDirection
  senderName   String
  viaBot       Boolean           @default(false)
  text         String            @default("")
  mediaType    String?
  mimeType     String?
  fileId       String?
  sentAt       DateTime
  editedAt     DateTime?
  previousText String?
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())

  alerts    TelegramAlert[]
  receipt   TelegramReceipt?
  mediaFile TelegramMediaFile?

  @@unique([chatId, messageId])
  @@index([sentAt])
  @@map("telegram_message")
}

model TelegramAlert {
  id        String                @id @default(cuid())
  chatId    String
  chat      TelegramChat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId String?
  message   TelegramMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  type      TelegramAlertType
  severity  TelegramAlertSeverity
  evidence  String
  resolved  Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@unique([messageId, type, evidence])
  @@index([resolved, createdAt])
  @@index([chatId])
  @@map("telegram_alert")
}

/// Claude ከቻቱ ያወጣው ሽያጭ ወይም ምዝገባ። ቻቱ በተተነተነ ቁጥር የዚያ ቻት ስምምነቶች ይተካሉ።
model TelegramDeal {
  id            String             @id @default(cuid())
  chatId        String
  chat          TelegramChat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  kind          TelegramDealKind
  item          String
  amountEtb     Int?
  status        TelegramDealStatus
  /// true፦ ወደ ድርጅቱ ሂሳብ ተከፍሏል፤ false፦ ወደ ሌላ ሂሳብ፤ null፦ አልተረጋገጠም
  paidToCompany Boolean?
  customerName  String?
  customerPhone String?
  note          String             @default("")
  /// ስምምነቱ ወይም ክፍያው የተፈጸመበት የመልዕክት ጊዜ
  dealAt        DateTime
  createdAt     DateTime           @default(now())

  @@index([chatId])
  @@index([dealAt])
  @@map("telegram_deal")
}

/// ደንበኛ የላከው ፎቶ/ፋይል የክፍያ ደረሰኝ ከሆነ Claude ያነበበው መረጃ።
model TelegramReceipt {
  id               String          @id @default(cuid())
  messageId        String          @unique
  message          TelegramMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  isReceipt        Boolean
  provider         String?
  amountEtb        Float?
  recipientName    String?
  recipientAccount String?
  payerName        String?
  transactionId    String?
  paidAt           String?
  toCompany        Boolean?
  createdAt        DateTime        @default(now())

  @@index([transactionId])
  @@map("telegram_receipt")
}

/// የፎቶው የተጨመቀ ቅጂ (WebP)፤ ፎቶው በቴሌግራም ቢሰረዝም ማስረጃው እንዲቀር መልዕክቱ ሲመጣ ይቀመጣል።
model TelegramMediaFile {
  id        String          @id @default(cuid())
  messageId String          @unique
  message   TelegramMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType  String
  width     Int
  height    Int
  data      Bytes
  createdAt DateTime        @default(now())

  @@map("telegram_media_file")
}
